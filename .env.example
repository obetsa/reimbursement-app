# PostgreSQL password (для docker-compose db сервісу)
POSTGRES_PASSWORD=12345678

# Flask session secret (згенеруй рандомний рядок)
SECRET_KEY=change-me-to-random-secret

# Google OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REDIRECT_URI=http://localhost:5500/auth/callback

# SMTP (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=your@gmail.com

# Superadmin panel (/admin)
ADMIN_TOKEN=change-me-to-random-token
